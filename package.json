{
  "name": "partyshow",
  "version": "1.0.0",
  "description": "Gjenbrukbar gameshow-app med temaer, storskjerm og kontrollpanel",
  "homepage": "https://github.com/karius-stack/PartyShow#readme",
  "bugs": {
    "url": "https://github.com/karius-stack/PartyShow/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karius-stack/PartyShow.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --import tsx --env-file-if-exists=.env server/index.ts --prod",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/grenze": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "express": "^5.3.0",
    "motion": "^14.0.0",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
