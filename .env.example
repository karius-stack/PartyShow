# PIN-kode for kontrollpanelet (/admin)
ADMIN_PIN=1031
# Port for serveren (i dev kjører Vite på 5173 og proxier hit)
PORT=3001
# Valgfritt: annen mappe for database og opplastinger
# DATA_DIR=./data

# Kåring: OpenAI-nøkkel for å fjerne bakgrunn og gi deltakerne en kul positur.
# Uten nøkkel brukes originalbildene.
OPENAI_API_KEY=
# Valgfritt: bildemodell (standard gpt-image-1.5)
# OPENAI_IMAGE_MODEL=gpt-image-1.5
# Valgfritt: adressen mobilene skal bruke i QR-koden, f.eks. http://192.168.1.20:3001
# Standard er maskinens LAN-adresse.
# PUBLIC_URL=
